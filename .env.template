# WTF Studio Environment Variables Template
# Copy this to .env and fill in your values

# =============================================================================
# SECURITY (REQUIRED IN PRODUCTION)
# =============================================================================
WTF_SECRET_KEY=your-secret-key-here-change-in-production
WTF_PORTAL_KEY=your-portal-auth-key-here

# =============================================================================
# PERSISTENCE (RENDER DEPLOYMENT)
# =============================================================================
# For Render persistent disk mounted at /var/data:
# Set these to persist user accounts and files across deploys
#
# DB_PATH=/var/data/wtf_studio.db
# STORAGE_ROOT=/var/data/storage
#
# Defaults (local dev):
# DB_PATH=portal/private/db/wtf_studio.db
# STORAGE_ROOT=portal/private/storage

DB_PATH=
STORAGE_ROOT=

# =============================================================================
# LOOPS EMAIL (OPTIONAL — enables auto-sync of waitlist signups to Loops.so)
# =============================================================================
LOOPS_API_KEY=

# =============================================================================
# FFMPEG (OPTIONAL)
# =============================================================================
# Custom FFmpeg paths (defaults to system PATH)
# FFMPEG_PATH=/path/to/ffmpeg
# FFPROBE_PATH=/path/to/ffprobe

# =============================================================================
# DISCORD INTEGRATION (OPTIONAL — enables "Connect Discord" on the profile
# page and one-way role sync: Brandr tier/Founding -> Discord roles)
# =============================================================================
# From the Discord Developer Portal (discord.com/developers/applications) for
# the brandr.online application:
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# OAuth2 -> Redirects, must match exactly:
DISCORD_REDIRECT_URI=https://brandr.online/portal/discord/callback
# Bot tab -> Token (needs the "Manage Roles" permission in the target server,
# and the bot's own role must sit ABOVE every role it assigns):
DISCORD_BOT_TOKEN=
# The target server's id (right-click the server icon -> Copy Server ID, with
# Developer Mode on in Discord settings):
DISCORD_GUILD_ID=
# Role ids on that server (right-click each role -> Copy Role ID). Leave any
# of these blank to skip syncing that role for now:
DISCORD_ROLE_VERIFIED=
DISCORD_ROLE_EXPLORER=
DISCORD_ROLE_CREATOR=
DISCORD_ROLE_STUDIO=
DISCORD_ROLE_PLATINUM=
DISCORD_ROLE_FOUNDING=
